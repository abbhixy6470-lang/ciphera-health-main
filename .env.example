# Ciphera Health+ — environment variables
# Copy to .env for local testing (never commit .env).
# In Vercel, set these as Environment variables (usually auto-provided by
# the Vercel Postgres / Neon integration):

# PostgreSQL / Neon connection string (Vercel Postgres integration sets POSTGRES_URL)
POSTGRES_URL=postgres://user:password@host/branch/app_name?sslmode=require
# Optional alias:
DATABASE_URL=

# Optional: set to false if TLS verification should be disabled
POSTGRES_SSL=true